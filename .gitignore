# ============================================================
# Data Files (LARGE - don't commit to git!)
# ============================================================
backend/data/raw/*.csv
backend/data/raw/*.parquet
backend/data/features/*.parquet

# Exceptions: Keep empty directories
!backend/data/raw/.gitkeep
!backend/data/features/.gitkeep

# ============================================================
# Model Files (LARGE - don't commit to git!)
# ============================================================
backend/models/**/*.joblib
backend/models/**/*.pkl
backend/models/**/*.h5

# Keep model metadata (small JSON files)
!backend/models/**/meta.json

# ============================================================
# IDE / Editor
# ============================================================
